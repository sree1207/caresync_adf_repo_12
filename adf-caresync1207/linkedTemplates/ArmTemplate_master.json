{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync1207"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncproject1207.dfs.core.windows.net/"
		},
		"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1101-103139-sd89p0nv"
		},
		"LS_AzureSqlDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-server012.database.windows.net"
		},
		"LS_AzureSqlDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresync012"
		},
		"LS_AzureSqlDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sree"
		},
		"LS_keyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-keyvault1207.vault.azure.net/"
		},
		"LS_postgreSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-winter-resonance-a1izupt0-pooler.ap-southeast-1.aws.neon.tech"
		},
		"LS_postgreSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_postgreSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync1207_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_keyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_keyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"LS_AzureSqlDB_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDB_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDB_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDB_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDB_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDB_properties_typeProperties_userName')]"
					},
					"LS_postgreSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_postgreSQL_properties_typeProperties_server')]"
					},
					"LS_postgreSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_postgreSQL_properties_typeProperties_database')]"
					},
					"LS_postgreSQL_properties_typeProperties_username": {
						"value": "[parameters('LS_postgreSQL_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}